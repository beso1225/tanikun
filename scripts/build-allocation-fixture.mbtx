///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
}

///|
async fn main {
  let root = ".cache/allocation-fixture"
  // Recreate this generated workspace so stale sources and dependency links
  // cannot hide missing setup on a fresh checkout.
  if @fs.exists(root) {
    @fs.rmdir(root, recursive=true)
  }
  @fs.mkdir(root + "/apps", recursive=true, allow_exist=true)
  @shell.Cmd("cp", ["-R", "apps/web", root + "/apps/"]).run()
  @shell.Cmd("cp", ["-R", "packages", root + "/"]).run()
  @fs.write_file(
    root + "/moon.work",
    "members = [\"./apps/web\", \"./packages/domain\", \"./packages/requirements\"]\n",
  )
  let fixture = @fs.read_file("tests/integration/fixtures/allocations.mbt")
  @fs.write_file(root + "/apps/web/app/allocation_fixture.mbt", fixture.text())
  let source = @fs.read_file("apps/web/cmd/browser/main.mbt")
  let injected = source
    .text()
    .replace(old="@app.sample_state()", new="@app.allocation_fixture_state()")
  if injected == source.text() {
    @shell.Cmd("sh", [
      "-c", "echo 'allocation fixture seed replacement failed' >&2; exit 1",
    ]).run()
  }
  @fs.write_file(root + "/apps/web/cmd/browser/main.mbt", injected)
  @shell.Cmd("pnpm", [
    "exec",
    "tailwindcss",
    "-i",
    "apps/web/styles/input.css",
    "-o",
    root + "/apps/web/public/styles.css",
    "--minify",
  ]).run()
  @shell.Cmd("warren", ["-C", root + "/apps/web", "build"]).run()
}
