{
  "name": "tanikun-api-test",
  "main": "../bridges/worker.mjs",
  "compatibility_date": "2026-10-12",
  "send_metrics": false,
  "vars": {
    "APP_ENV": "local",
    "DEV_AUTH": "true",
    "DEV_AUTH_IDENTITIES": "{\"local-fixture-token-alice\":\"dev-alice\",\"local-fixture-token-bob\":\"dev-bob\"}",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tanikun-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../migrations",
    },
  ],
}
