{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tanikun-api",
  "main": "apps/api/bridges/worker.mjs",
  "compatibility_date": "2026-10-12",
  "send_metrics": false,
  "build": {
    "command": "moon build --target js --release --deny-warn",
    "watch_dir": ["apps/api"],
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
  },
}
