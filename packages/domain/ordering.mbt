///|
/// Compares strings lexicographically by UTF-16 code units.
///
/// This intentionally differs from core `String::compare`, which is shortlex
/// (length first). IDs use this comparator so their order is lexicographic.
fn compare_code_units(left : String, right : String) -> Int {
  let shared = if left.length() < right.length() {
    left.length()
  } else {
    right.length()
  }
  for index in 0..<shared {
    if left[index] != right[index] {
      return if left[index] < right[index] { -1 } else { 1 }
    }
  }
  if left.length() < right.length() {
    -1
  } else if left.length() > right.length() {
    1
  } else {
    0
  }
}
